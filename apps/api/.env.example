# =====================================================================
# apps/api 環境變數
# 本機：複製成 apps/api/.env（已被 .gitignore 排除），`pnpm --filter api dev` 會自動讀取。
# Railway：在服務 Variables 設定同名變數。
# 註解請寫在獨立一行（不要寫在值的後面）。
# =====================================================================

# ---------- 基本 ----------
# production 時：WEB_URL 必填、CORS 不再允許 http://localhost:3000
NODE_ENV=development
# Railway 會自動注入；預設 8080
PORT=8080
# 選填。程式一律以 +08:00 計算台北時間，不依賴系統時區
TZ=Asia/Taipei

# ---------- Supabase（必填；缺少時啟動失敗並列出缺哪個）----------
# 正式：https://<project-ref>.supabase.co；本機 supabase start：http://127.0.0.1:54321
SUPABASE_URL=http://127.0.0.1:54321
# service_role key：只能放在後端（Supabase 後台 Project Settings → API；本機見 supabase status）
SUPABASE_SERVICE_ROLE_KEY=

# ---------- 網址 ----------
# 前端網址（CORS 白名單，可逗號分隔多個；第一個用於付款完成後導回 /booking/success）
# 正式：https://<domain>；production 必填；開發環境未設時為 http://localhost:3000
WEB_URL=http://localhost:3000
# 本 API 的對外網址（綠界 ReturnURL / PaymentInfoURL、LINE Pay confirmUrl 用）
# 正式：https://<railway-app>.up.railway.app；production 未設時金流全部停用；開發環境未設時為 http://localhost:$PORT
API_URL=http://localhost:8080

# ---------- 綠界 ECPay 全方位金流（三個都有才啟用信用卡與 ATM）----------
# stage → payment-stage.ecpay.com.tw；prod → payment.ecpay.com.tw
ECPAY_ENV=stage
# 下列為綠界公開測試特店（developers.ecpay.com.tw「測試介接資訊」），正式環境請換成自己的
# （ECPAY_ENV=prod 搭配 3002607 會被判定設定錯誤而停用）
ECPAY_MERCHANT_ID=3002607
ECPAY_HASH_KEY=pwFHCqoQZGmho4w6
ECPAY_HASH_IV=EkRm7iFT261dpevs
# ATM 轉帳：預設關閉（網站不顯示 ATM 選項、新預約不接受 ATM）；要重新開放才設為 true
# ATM_ENABLED=true

# ---------- LINE Pay v3（兩個都有才啟用；未設定時 /config line=false、request 回 503）----------
# sandbox → sandbox-api-pay.line.me；prod → api-pay.line.me
LINEPAY_ENV=sandbox
LINEPAY_CHANNEL_ID=
LINEPAY_CHANNEL_SECRET=

# ---------- 寄信（Resend REST API）----------
# 空白 → dry-run：只記錄收件網域與主旨，不寄出
RESEND_API_KEY=
# RESEND_API_KEY 有設時必填；網域需先在 Resend 驗證（Railway 變數值不要加引號：緣舍命理 <hello@domain>）
MAIL_FROM="緣舍命理 <hello@domain>"
# 選填：老師的信箱，收新訂單通知與需人工處理的異常通知（可逗號分隔多個）
ADMIN_EMAIL=
# 選填：確認信的視訊連結；未設時信中寫「視訊連結將於諮詢前另行寄送」
MEET_URL=

# ---------- 版本（GET /health 的 version）----------
# 優先讀 apps/api/BUILD_SHA 檔（CI 在 railway up 前寫入）；檔案不存在才用 GIT_SHA；都沒有回 "dev"
GIT_SHA=

# 選填：debug 等級 log
# LOG_LEVEL=debug
