# apps/web（Vercel）環境變數
# 本機開發：複製成 .env.local 再填值；全部留空也能跑（方案資料會用內建的 SVCS）

# Supabase（只用 anon key 讀 services，RLS 只開放 active 方案）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Railway 上的 apps/api（預約、金流），例：https://<railway-app>.up.railway.app
NEXT_PUBLIC_API_URL=

# 正式網址（canonical、OG、robots、sitemap 用），例：https://<domain>
# 未設定時 Vercel 會退回 VERCEL_PROJECT_PRODUCTION_URL，本機退回 http://localhost:3000
NEXT_PUBLIC_SITE_URL=
